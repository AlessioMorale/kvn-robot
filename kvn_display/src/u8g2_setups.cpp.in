// Generated by CMakeLists.txt from u8g2.h: every u8g2 full-buffer setup function, by driver name.

#include <algorithm>
#include <array>
#include <string_view>
#include <utility>

#include "kvn_display/display.hpp"

namespace kvn_display
{

namespace
{

// Sorted by name
constexpr std::array<std::pair<std::string_view, U8g2Setup>, @U8G2_SETUP_COUNT@> kSetups = {{
@U8G2_SETUP_ENTRIES@
}};

}  // namespace

U8g2Setup find_setup(std::string_view driver)
{
  const auto it = std::lower_bound(
    kSetups.begin(), kSetups.end(), driver,
    [](const auto & entry, std::string_view name) {return entry.first < name;});
  return it != kSetups.end() && it->first == driver ? it->second : nullptr;
}

}  // namespace kvn_display
