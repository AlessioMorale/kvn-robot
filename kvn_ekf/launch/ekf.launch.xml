<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- 
    Extended Kalman Filter using locusrobotics/fuse framework
    
    Fuses odometry (wheel encoders) + IMU (gyroscope) for robust 2D pose estimation
    Publishes optimized pose to /odom_ekf with full covariance
    
    Architecture: Factor graph optimization using Ceres solver (better than basic EKF)
    
    Usage: ros2 launch kvn_ekf ekf.launch.xml
  -->

  <!-- Parameters -->
  <arg name="debug" default="false" description="Enable debug logging"/>
  <arg name="enable_rviz" default="false" description="Launch RViz visualization"/>
  <arg name="config_file" default="$(find-pkg-share kvn_ekf)/config/fuse_ekf.yaml"/>

  <!-- Main fuse optimizer node (handles factor graph optimization) -->
  <node
    pkg="fuse_optimizers"
    exec="fuse_optimizers_node"
    name="fusion_optimizer"
    output="screen">
    
    <!-- Load sensor/motion model plugins -->
    <!-- These provide the factors (constraints) to the optimization graph -->
    <param name="config_file" value="$(var config_file)"/>

</launch>
