<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kvn_orchestrator</name>
  <version>0.0.0</version>
  <description>BehaviorTree.CPP orchestration (Nav2 BT API) for KVN rover autonomous functions, configured as XML</description>
  <maintainer email="alessiomorale@gmail.com">Alessio Morale</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>nav2_ros_common</depend>
  <depend>explore_lite_msgs</depend>
  <!-- Nav2's NavigateToPose and GoalReached BT plugins are loaded at runtime -->
  <exec_depend>nav2_behavior_tree</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>rclcpp_action</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
