<?xml version="1.0"?>
<launch>
  <description>Launch joystick to Twist converter</description>

  <!-- Joy to Twist converter node -->
  <!-- Converts sensor_msgs/Joy to geometry_msgs/Twist -->
  <node pkg="kvn_joy_teleop" exec="joy_to_twist_node" name="joy_to_twist">
    <param name="max_linear_vel" value="1.0" />
    <param name="max_angular_vel" value="2.0" />
    <param name="linear_axis" value="1" />      <!-- Left stick Y -->
    <param name="angular_axis" value="3" />     <!-- Right stick X -->
    <param name="linear_inverted" value="false" />
    <param name="angular_inverted" value="false" />
  </node>

</launch>
