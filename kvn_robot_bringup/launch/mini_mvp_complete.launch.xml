<?xml version="1.0"?>
<launch>
  <description>Full system launch: Control + Odometry + SLAM</description>

  <arg name="use_mock_hardware" default="false" />

  <!-- Robot state publisher -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" command="xacro $(find kvn_robot_description)/urdf/kvn_rover.urdf.xacro use_mock_hardware:=$(var use_mock_hardware)" />
  </node>

  <!-- Controller manager + joint state broadcaster + skid steer controller -->
  <include file="$(find kvn_robot_bringup)/launch/controller.launch.xml" />

  <!-- LIDAR + SLAM Toolbox -->
  <include file="$(find kvn_robot_bringup)/launch/slam.launch.xml" />

</launch>
