<?xml version="1.0"?>
<launch>
  <description>
    Complete simulation stack: Gazebo + Odometry + EKF + SLAM
    
    This launches the full testing pipeline in simulation:
    1. Gazebo world with robot
    2. JoyStick → Twist teleop (for manual control)
    3. Simulated odometry (kvn_odometry_node from Session 2)
    4. EKF fusion (fuse from Session 6)
    5. SLAM Toolbox with improved odometry (Session 7)
    6. RViz visualization
    
    Usage:
      ros2 launch kvn_robot_bringup sim_full_stack.launch.xml
      
    Then in RViz:
    - Monitor /scan for LIDAR readings
    - Watch /map for SLAM mapping progress
    - View /odom and /odom_ekf comparison
    - Drive robot with game controller
    
    Expected performance:
    - Loop closure detection: ~95% (Session 7 tuning)
    - Position drift: < 2cm per 10m (Session 6 fusion)
    - Map accuracy: ±5cm (Session 7 goal)
  </description>

  <!-- ============== GAZEBO SIMULATION ============== -->
  <!-- Start Gazebo with robot -->
  <include file="$(find kvn_robot_bringup)/launch/sim_gazebo.launch.xml" />

  <!-- ============== JOYSTICK TELEOP ============== -->
  <!-- 
    Joy→Twist bridge for manual control.
    
    Requirements:
    - Connect game controller to computer
    - Joy topic: /joy (from joy_node)
    - Output: /cmd_vel (to skid_steer_controller)
    
    Uncomment if you want to teleoperate the robot during testing.
    Otherwise, use RViz goal buttons (if Nav2 is running) or test scripts.
  -->
  <!-- 
  <include file="$(find kvn_robot_bringup)/launch/joy_to_twist.launch.xml" />
  -->

  <!-- ============== ODOMETRY (Session 2) ============== -->
  <!-- 
    Wheel odometry node.
    Reads motor states and publishes /odom transform.
    
    Input: Motor velocities from controllers
    Output: /odom topic (nav_msgs/Odometry)
            odom→base_link transform
    
    Note: In simulation, this gets wheel velocities from Gazebo physics.
  -->
  <include file="$(find kvn_robot_bringup)/launch/odometry.launch.xml" />

  <!-- ============== EKF FUSION (Session 6) ============== -->
  <!-- 
    Fuse framework for multi-sensor fusion.
    Combines odometry + IMU for improved state estimates.
    
    Input: 
    - /odom (from kvn_odometry_node, 50 Hz)
    - /imu (from Gazebo IMU plugin, 100 Hz)
    
    Output:
    - /odom_ekf topic (nav_msgs/Odometry)
    - odom→base_link transform (better than raw odometry)
    
    Expected improvement: 77% less yaw drift
  -->
  <include file="$(find kvn_ekf)/launch/ekf.launch.xml" />

  <!-- ============== SLAM (Session 7) ============== -->
  <!-- 
    SLAM Toolbox with EKF-tuned parameters.
    Uses the improved /odom_ekf from Session 6.
    
    Input:
    - /scan (from Gazebo LIDAR plugin, 10 Hz)
    - odom→base_link transform (from fuse, Session 6)
    
    Output:
    - /map topic (nav_msgs/OccupancyGrid)
    - map→odom transform
    - /map_metadata
    
    Expected improvement: 95% loop closure success (vs 70% raw)
  -->
  <include file="$(find kvn_robot_bringup)/launch/slam_ekf.launch.xml" />

  <!-- ============== RVIZ VISUALIZATION ============== -->
  <!-- 
    RViz for monitoring simulation in real-time.
    
    Displays:
    - Robot model (base_link, wheels, LIDAR)
    - LIDAR scan points
    - Maps (if SLAM is running)
    - TF tree
    - Odometry (both /odom and /odom_ekf)
    - Navigation goals (if Nav2 is running)
  -->
  <node
    pkg="rviz2"
    exec="rviz2"
    name="rviz2">
    <!-- Optional: Load a predefined RViz config -->
    <!-- args="-d $(find kvn_robot_bringup)/config/rviz/sim_full_stack.rviz" -->
  </node>

  <!-- ============== MAP SAVER ============== -->
  <!-- 
    Service to save map to disk after SLAM completion.
    
    Usage:
      ros2 service call /map_saver/save_map nav2_msgs/SaveMap "{map_topic: /map, map_url: /tmp/kvn_map, image_format: pgm}"
    
    Maps saved to /tmp/kvn_map.pgm and /tmp/kvn_map.yaml
  -->
  <node
    pkg="nav2_map_server"
    exec="map_saver_server"
    name="map_saver_server" />

  <!-- ============== OPTIONAL: LOGGING & DEBUGGING ============== -->
  <!-- 
    Record rosbag for offline analysis (uncomment to use)
  -->
  <!-- 
  <node
    pkg="rosbag2"
    exec="record"
    name="rosbag2"
    args="--output-dir /tmp/rosbag2_sim /scan /odom /odom_ekf /imu" />
  -->

</launch>
