<?xml version="1.0"?>
<launch>
  <description>
    Gazebo simulation environment for KVN Rover
    
    This launch file brings up the complete Gazebo simulation pipeline:
    1. Gazebo with the kvn_robot_world
    2. Robot spawned at origin
    3. Robot state publisher (publishes TF tree)
    4. Controllers loaded and active
    
    Usage:
      ros2 launch kvn_robot_bringup sim_gazebo.launch.xml
      
    This provides simulated:
    - 2D LIDAR (Gazebo GPU Lidar → /scan topic)
    - IMU (6-axis → /imu topic)
    - Wheel odometry (from physics → available for controllers)
    - Motor control interfaces (velocity commands)
  </description>

  <!-- 
    Environment variables for Gazebo
    - Set physics engine parameters
    - Enable debugging if needed (comment out for production)
  -->
  <let name="use_sim_time" value="true" />
  <let name="world_name" value="kvn_robot" />

  <!-- ============== GAZEBO ENVIRONMENT ============== -->
  <!-- Start Gazebo server (physics engine) -->
  <node
    pkg="gz-sim"
    exec="gz"
    args="sim -r -v 4 $(find kvn_robot_description)/worlds/kvn_robot.world"
    name="gazebo">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(find kvn_robot_description)/worlds:$(find kvn_robot_description)/meshes" />
  </node>

  <!-- Start Gazebo client (visualization) - optional -->
  <!-- Comment out to run headless (server only) -->
  <node
    pkg="gz-sim"
    exec="gz"
    args="sim -g"
    name="gazebo_gui">
    <env name="GZ_SIM_RESOURCE_PATH" value="$(find kvn_robot_description)/worlds:$(find kvn_robot_description)/meshes" />
  </node>

  <!-- ============== ROBOT SPAWNING ============== -->
  <!-- 
    Spawn the robot model into Gazebo at origin.
    The robot URDF is automatically loaded with sim_gazebo=true,
    which enables Gazebo physics plugins.
  -->
  <node
    pkg="ros_gz_sim"
    exec="create"
    args="-name kvn_rover -x 0 -y 0 -z 0.1 -file $(find kvn_robot_description)/urdf/kvn_rover.urdf.xacro sim_gazebo:=true" />

  <!-- ============== ROBOT STATE PUBLISHER ============== -->
  <!-- 
    Publishes robot TF tree based on URDF.
    Subscribes to /joint_states and publishes TF transforms.
    
    This is essential for:
    - Robot visualization in RViz
    - Navigation stack (needs base_link → laser TF)
    - Any other components using TF
  -->
  <node
    pkg="robot_state_publisher"
    exec="robot_state_publisher">
    <param name="robot_description" command="xacro $(find kvn_robot_description)/urdf/kvn_rover.urdf.xacro sim_gazebo:=true" />
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <remap from="joint_states" to="joint_states" />
  </node>

  <!-- ============== CONTROLLERS ============== -->
  <!-- 
    Launch controller manager and controllers.
    This is required for motor control interface.
    
    Controllers loaded:
    - skid_steer_controller (interprets Twist commands → wheel velocities)
    - joint_state_broadcaster (publishes /joint_states from hardware)
  -->
  <include file="$(find kvn_robot_bringup)/launch/controller.launch.xml">
    <arg name="use_mock_hardware" value="false" />
    <arg name="use_sim_time" value="$(var use_sim_time)" />
  </include>

  <!-- ============== OPTIONAL: RViz Visualization ============== -->
  <!-- 
    Start RViz for visualization of:
    - Robot model
    - Robot TF tree
    - LIDAR scan data
    - Maps (from SLAM if running)
    - Navigation goals (if Nav2 running)
    
    Uncomment to enable RViz visualization
  -->
  <!-- 
  <node
    pkg="rviz2"
    exec="rviz2"
    args="-d $(find kvn_robot_bringup)/config/rviz/sim_config.rviz"
    name="rviz2" />
  -->

  <!-- ============== LOGGING ============== -->
  <!-- Enable ROS 2 parameters logging (for debugging) -->
  <!-- 
  <env name="ROS_LOG_DIR" value="$(env HOME)/.ros/log" />
  <env name="ROS_MASTER_URI" value="http://localhost:11311" />
  -->

</launch>
