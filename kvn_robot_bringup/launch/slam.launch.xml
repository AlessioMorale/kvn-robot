<?xml version="1.0"?>
<launch>
  <description>Launch LIDAR and SLAM for KVN rover mapping</description>

  <!-- LIDAR Node - SLAMTEC A1 or A2 -->
  <node pkg="sllidar_ros2" exec="sllidar_node" name="sllidar_node">
    <param name="channel_type" value="serial" />
    <param name="serial_port" value="/dev/ttyUSB0" />
    <param name="serial_baudrate" value="115200" />
    <param name="frame_id" value="laser" />
    <param name="inverted" value="false" />
    <param name="angle_compensate" value="true" />
    <param name="scan_mode" value="Standard" />
  </node>

  <!-- Static TF: base_link -> laser -->
  <!-- Adjust values to match actual LIDAR mounting on your robot -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="base_to_laser_tf">
    <arg name="--x" value="0.0" />
    <arg name="--y" value="0.0" />
    <arg name="--z" value="0.15" />
    <arg name="--roll" value="0.0" />
    <arg name="--pitch" value="0.0" />
    <arg name="--yaw" value="0.0" />
    <arg name="--frame-id" value="base_link" />
    <arg name="--child-frame-id" value="laser" />
  </node>

  <!-- SLAM Toolbox in Asynchronous Mode -->
  <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox">
    <param from="$(find kvn_robot_bringup)/config/slam/slam_toolbox_async.yaml" />
    <remap from="scan" to="/scan" />
  </node>

  <!-- Node to save map on demand -->
  <node pkg="nav2_map_server" exec="map_saver_server" name="map_saver_server" />

</launch>
