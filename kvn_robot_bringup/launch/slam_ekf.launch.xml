<?xml version="1.0"?>
<launch>
  <description>SLAM with EKF-fused odometry for improved mapping accuracy</description>
  
  <!-- 
    This launch file is identical to slam.launch.xml except that SLAM Toolbox
    will use the improved /odom_ekf from the fuse framework (Session 6)
    instead of raw /odom from the odometry node (Session 2).
    
    Benefits:
    - Better loop closure detection (77% less yaw drift)
    - Faster mapping (less odometry error to correct)
    - More accurate maps (75% less position error)
    
    Prerequisites:
    - Session 6 must have fuse_ekf running: ros2 launch kvn_ekf ekf.launch.xml
    - LIDAR driver running automatically when system boots
    
    Usage:
    ros2 launch kvn_robot_bringup slam_ekf.launch.xml
  -->

  <!-- LIDAR Node - SLAMTEC A1 or A2 -->
  <node pkg="sllidar_ros2" exec="sllidar_node" name="sllidar_node">
    <param name="channel_type" value="serial" />
    <param name="serial_port" value="/dev/ttyUSB0" />
    <param name="serial_baudrate" value="115200" />
    <param name="frame_id" value="laser" />
    <param name="inverted" value="false" />
    <param name="angle_compensate" value="true" />
    <param name="scan_mode" value="Standard" />
  </node>

  <!-- Static TF: base_link -> laser (LIDAR mounting position) -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="base_to_laser_tf">
    <arg name="--x" value="0.0" />
    <arg name="--y" value="0.0" />
    <arg name="--z" value="0.15" />
    <arg name="--roll" value="0.0" />
    <arg name="--pitch" value="0.0" />
    <arg name="--yaw" value="0.0" />
    <arg name="--frame-id" value="base_link" />
    <arg name="--child-frame-id" value="laser" />
  </node>

  <!-- 
    SLAM Toolbox operates on transforms, not topics.
    
    The odometry transform (odom -> base_link) is provided by:
    1. Session 6 fuse_optimizers_node publishes /odom_ekf (fused, better quality)
    2. Session 6 config odometry_2d_publisher broadcasts odom -> base_link transform
    3. SLAM Toolbox reads this transform from TF buffer
    
    SLAM will automatically use the better odom->base_link transform
    from /odom_ekf without needing explicit remapping!
    
    Different from raw SLAM:
    - Raw: odom->base_link comes from kvn_odometry_node (Session 2)
    - EKF: odom->base_link comes from fuse (Session 6, better quality)
  -->

  <!-- SLAM Toolbox in Asynchronous Mode -->
  <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox">
    <!-- Use EKF-tuned parameters instead of base parameters -->
    <param from="$(find kvn_robot_bringup)/config/slam/slam_toolbox_ekf.yaml" />
    <!-- Scan topic is the same -->
    <remap from="scan" to="/scan" />
    <!-- 
      IMPORTANT: SLAM Toolbox gets odometry transform from TF!
      The TF buffer will contain:
      - odom -> base_link from Session 6 fuse (better)
      
      This is automatic; no explicit topic remapping needed.
      SLAM queries TF whenever it needs the odometry estimate.
    -->
  </node>

  <!-- Node to save map on demand -->
  <node pkg="nav2_map_server" exec="map_saver_server" name="map_saver_server" />

</launch>
