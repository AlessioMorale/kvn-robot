[Unit]
Description=KVN control stack (ELRS joy, teleop, controllers)
After=network.target kvn-ina3221.service
# Never depends on WiFi/VPN (design R3, R5): no zerotier ordering here.

[Service]
Type=simple
User=kvn
EnvironmentFile=/etc/kvn/kvn-ros.env
# Control path: normal-or-better priority, never throttled.
Nice=-5
CPUWeight=500
Restart=on-failure
RestartSec=2
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source ${KVN_WS}/install/setup.bash && exec ros2 launch kvn_robot_bringup mini_mvp_complete.launch.py'

[Install]
WantedBy=multi-user.target
