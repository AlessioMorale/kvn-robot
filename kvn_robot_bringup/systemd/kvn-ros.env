# Shared environment for all kvn systemd units (EnvironmentFile=/etc/kvn/kvn-ros.env).
# DDS stays on the robot: never carried over the VPN (design §4).
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Workspace install prefix used by the units' ExecStart.
KVN_WS=/home/alessio/ros_kvn_robot_ws
# Hardware configuration (ports, battery limits). Unset: the workspace's
# kvn_robot_bringup/config/robot.yaml. Point it at a per-robot copy to configure this rover:
#KVN_ROBOT_CONFIG=/etc/kvn/robot.yaml
# Optional WLED signalling light; its serial port is ports.wled in robot.yaml.
KVN_WLED_ENABLED=false
# Optional status display; its driver and bus are the display section of robot.yaml.
KVN_DISPLAY_ENABLED=false
