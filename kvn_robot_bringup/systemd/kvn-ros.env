# Shared environment for all kvn systemd units (EnvironmentFile=/etc/kvn/kvn-ros.env).
# DDS stays on the robot: never carried over the VPN (design §4).
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Workspace install prefix used by the units' ExecStart.
KVN_WS=/home/kvn/ros_kvn_ws
