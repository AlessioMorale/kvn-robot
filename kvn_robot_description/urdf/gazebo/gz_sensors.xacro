<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Gazebo (gz-sim) sensors for the KVN rover; only active with sim_gazebo:=true.
    gz_frame_id makes the bridged messages carry the same frame names as the real drivers
    (lidar_attachment_link for the lidar, imu_link for the IMU).

    Frame note: the RGB-D point cloud is published in oak_rgb_camera_frame (x forward), the
    non-optical camera frame, because gz clouds are not in the z-forward optical convention.
  -->
  <xacro:if value="$(arg sim_gazebo)">

    <!-- Skid steering needs the wheels to slip sideways: mu2 (lateral) < mu1 (rolling) -->
    <gazebo reference="front_left_link">
      <mu1>1.0</mu1>
      <mu2>0.4</mu2>
    </gazebo>
    <gazebo reference="front_right_link">
      <mu1>1.0</mu1>
      <mu2>0.4</mu2>
    </gazebo>
    <gazebo reference="back_left_link">
      <mu1>1.0</mu1>
      <mu2>0.4</mu2>
    </gazebo>
    <gazebo reference="back_right_link">
      <mu1>1.0</mu1>
      <mu2>0.4</mu2>
    </gazebo>

    <gazebo reference="lidar_attachment_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_attachment_link</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>imu</topic>
        <update_rate>100</update_rate>
        <always_on>true</always_on>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.003</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.05</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

    <!-- OAK-D Lite stereo depth: ~73 deg HFOV, usable range ~0.2-5 m -->
    <gazebo reference="camera_attachment_link">
      <sensor name="oak_rgbd" type="rgbd_camera">
        <gz_frame_id>oak_rgb_camera_frame</gz_frame_id>
        <topic>camera</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>

  </xacro:if>
</robot>
