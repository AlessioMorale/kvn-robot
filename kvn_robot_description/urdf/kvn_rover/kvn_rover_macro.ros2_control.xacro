<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="ds210_joint" params="name id invert:=false position:=false">
      <joint name="${name}">
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <!-- Only the simulator exports wheel position; without it joint_states carries NaN
             and robot_state_publisher rejects the wheel transforms -->
        <xacro:if value="${position}">
          <state_interface name="position"/>
        </xacro:if>
        <param name="motor_id">${id}</param>
        <param name="invert">${invert}</param>
    </joint>
  </xacro:macro>
  <xacro:macro name="kvn_rover_ros2_control" params="
               name
               prefix
               use_mock_hardware:=false
               mock_sensor_commands:=false
               sim_gazebo:=false
               simulation_controllers"
               >

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="mock_sensor_commands">${mock_sensor_commands}</param>
        </xacro:if>
        <xacro:if value="${sim_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware or sim_gazebo}">
          <plugin>ddsm210_hardware_interface/HardwareInterfaceDDSM210</plugin>
          <param name="device">/dev/ttyAMA0</param>
        </xacro:unless>
      </hardware>
      <xacro:ds210_joint name="${prefix}front_left_joint" id="3" position="${sim_gazebo}"/>
      <xacro:ds210_joint name="${prefix}front_right_joint" id="1" invert="true" position="${sim_gazebo}"/>
      <xacro:ds210_joint name="${prefix}back_left_joint" id="4" position="${sim_gazebo}"/>
      <xacro:ds210_joint name="${prefix}back_right_joint" id="2" invert="true" position="${sim_gazebo}"/>
    </ros2_control>

    <xacro:if value="$(arg sim_gazebo)">
      <!-- Gazebo plugins -->
      <gazebo reference="world">
      </gazebo>
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${simulation_controllers}</parameters>
          <controller_manager_node_name>${prefix}controller_manager</controller_manager_node_name>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
